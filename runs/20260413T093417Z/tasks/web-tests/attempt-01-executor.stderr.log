name: Validate Pull request for API

on:
  workflow_dispatch:
  pull_request:
    paths:
      - 'kiubo-api/**'
      - 'kiubo-pdf-api/**'
      - 'kiubo-web/**'
      - '!kiubo-web/dist-staging/**'
      - '!kiubo-web/dist-production/**'
      - 'deploy-single/**'
      - 'deploy-scaling/**'
      - '.github/workflows/kiubo-pr-validate.yml'

concurrency:
  group: pr-validate-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

env:
  TF_VAR_db_username: ${{ secrets.TF_VAR_DB_USERNAME }}
  TF_VAR_db_password: ${{ secrets.TF_VAR_DB_PASSWORD }}
  TF_VAR_django_secret_key: ${{ secrets.TF_VAR_DJANGO_SECRET_KEY }}

jobs:
  changes:
    name: Detect Changed Areas
    runs-on: ubuntu-latest
    outputs:
      api_changed: ${{ steps.filter.outputs.api_changed }}
      pdf_changed: ${{ steps.filter.outputs.pdf_changed }}
      web_changed: ${{ steps.filter.outputs.web_changed }}
      infra_single_changed: ${{ steps.filter.outputs.infra_single_changed }}
      infra_scaling_changed: ${{ steps.filter.outputs.infra_scaling_changed }}
    steps:
      - name: Checkout
        uses: actions/checkout@v5
        with:
          fetch-depth: 0
      - name: Detect changes
        id: filter
        if: github.event_name != 'workflow_dispatch'
        uses: dorny/paths-filter@v3
        with:
          filters: |
            api_changed:
              - 'kiubo-api/**'
            pdf_changed:
              - 'kiubo-pdf-api/**'
            web_changed:
              - 'kiubo-web/**'
              - '!kiubo-web/dist-staging/**'
              - '!kiubo-web/dist-production/**'
            infra_single_changed:
              - 'deploy-single/**'
            infra_scaling_changed:
              - 'deploy-scaling/**'

  api-test-and-lint:
    name: Test and Lint
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.api_changed == 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v5
      - name: Test
        run: |
          cd kiubo-api/
          docker compose run --rm api sh -c "python manage.py wait_for_db && python manage.py test && flake8"

  pdf-api-test:
    name: Test PDF API
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.pdf_changed == 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v5
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: kiubo-pdf-api/package-lock.json
      - name: Install dependencies
        run: |
          cd kiubo-pdf-api/
          npm ci
      - name: Run tests
        run: |
          cd kiubo-pdf-api/
          npm test


  web-test:
    name: Test WEB
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.web_changed == 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v5
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: kiubo-web/package-lock.json
      - name: Install dependencies
        run: |
          cd kiubo-web/
          npm ci
      - name: Run tests
        run: |
          cd kiubo-web/
          npm test -- --watch=false --browsers=ChromeHeadlessCI

  validate-terraform-scaling:
    name: Validate Terraform Scaling
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.infra_scaling_changed == 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v5
      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v4
        with:
          terraform_version: 1.10.5
      - name: Terraform Init
        run: |
          cd deploy-scaling/
          terraform init -backend=false
      - name: Terraform Format
        run: |
          cd deploy-scaling/
          terraform fmt -check
      - name: Terraform Validate
        run: |
          cd deploy-scaling/
          terraform validate

  validate-terraform-single:
    name: Validate Terraform Single
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.infra_single_changed == 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v5
      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v4
        with:
          terraform_version: 1.10.5
      - name: Terraform Init
        run: |
          cd deploy-single/
          terraform init -backend=false
      - name: Terraform Format
        run: |
          cd deploy-single/
          terraform fmt -check
      - name: Terraform Validate
        run: |
          cd deploy-single/
          terraform validate

