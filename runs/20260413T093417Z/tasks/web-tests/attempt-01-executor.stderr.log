import { HttpClientTestingModule, HttpTestingController } from '@angular/common/http/testing';
import { TestBed } from '@angular/core/testing';
import { TranslationService } from 'src/app/ui/i18n';
import { environment } from 'src/environments/environment';
import { DisableRoomListDto } from './dto/disable-room-list-dto.model';
import { DisableRoomDto } from './dto/room/disable-room-dto.model';
import { RenameRoomDto } from './dto/room/rename-room-dto.model';
import { RoomDto } from './dto/room/room-dto.model';
import { RoomHTTPService } from './room-http.service';

describe('RoomHTTPService', () => {
  let service: RoomHTTPService;
  let httpMock: HttpTestingController;
  let translationService: jasmine.SpyObj<TranslationService>;

  const token = 'auth-token';
  const apiBase = `${environment.apiUrl}game/`;
  const roomApi = `${apiBase}room/`;

  beforeEach(() => {
    translationService = jasmine.createSpyObj('TranslationService', ['getSelectedLanguage']);
    translationService.getSelectedLanguage.and.returnValue('en');

    TestBed.configureTestingModule({
      imports: [HttpClientTestingModule],
      providers: [
        RoomHTTPService,
        { provide: TranslationService, useValue: translationService },
      ],
    });

    service = TestBed.inject(RoomHTTPService);
    httpMock = TestBed.inject(HttpTestingController);
  });

  afterEach(() => {
    httpMock.verify();
  });

  it('getRoomList should call room endpoint with pagination params', () => {
    service.getRoomList(token, 20, 3).subscribe();

    const req = httpMock.expectOne((r) =>
      r.method === 'GET' && r.url === roomApi && r.params.get('page_size') === '20' && r.params.get('page') === '3'
    );

    expect(req.request.headers.get('Authorization')).toBe(`Token ${token}`);
    req.flush({ count: 0, total_pages: 0, results: [] });
  });

  it('getRoomDetail should call room detail endpoint', () => {
    service.getRoomDetail(token, 'room-1').subscribe();

    const req = httpMock.expectOne(`${roomApi}room-1/`);
    expect(req.request.method).toBe('GET');
    req.flush({ id: 'room-1', games: [] });
  });

  it('getRoomHistoricalList should request disabled rooms with pagination', () => {
    service.getRoomHistoricalList(token, 10, 2).subscribe();

    const req = httpMock.expectOne((r) =>
      r.method === 'GET' &&
      r.url === roomApi &&
      r.params.get('enabled') === '0' &&
      r.params.get('page_size') === '10' &&
      r.params.get('page') === '2'
    );

    req.flush({ count: 0, total_pages: 0, results: [] });
  });

  it('downloadPdf should call ticket endpoint with language and timezone', () => {
    service.downloadPdf(token, 'room-2').subscribe();

    const req = httpMock.expectOne((r) =>
      r.method === 'GET' && r.url === `${apiBase}ticket/room-2` && r.responseType === 'blob'
    );

    expect(req.request.headers.get('Accept-Language')).toBe('en');
    expect(req.request.params.has('time_zone')).toBeTrue();
    req.flush(new Blob(['pdf']));
  });

  it('downloadScoreSheetPdf should call pdf api with room id', () => {
    service.downloadScoreSheetPdf(token, 'room-3').subscribe();

    const req = httpMock.expectOne((r) =>
      r.method === 'GET' &&
      r.url === `${environment.pdfApiUrl}score-sheet` &&
      r.params.get('room_id') === 'room-3' &&
      r.responseType === 'blob'
    );

    req.flush(new Blob(['score-sheet']));
  });

  it('getTicketInfo should call ticket-json endpoint', () => {
    service.getTicketInfo(token, 'room-4').subscribe();

    const req = httpMock.expectOne(`${apiBase}ticket-json/room-4`);
    expect(req.request.method).toBe('GET');
    req.flush({});
  });

  it('patchRoom should patch room with payload', () => {
    const roomDto = new RoomDto('room-5', 123, 2, 4, 'host', 'name', true);
    service.patchRoom(token, roomDto).subscribe();

    const req = httpMock.expectOne(`${roomApi}room-5/`);
    expect(req.request.method).toBe('PATCH');
    expect(req.request.body).toEqual(roomDto);
    req.flush(roomDto);
  });

  it('patchDisableRoom should patch disable payload', () => {
    const dto = new DisableRoomDto('room-6', false);
    service.patchDisableRoom(token, dto).subscribe();

    const req = httpMock.expectOne(`${roomApi}room-6/`);
    expect(req.request.method).toBe('PATCH');
    expect(req.request.body).toEqual(dto);
    req.flush(dto);
  });

  it('patchRenameRoom should patch rename payload', () => {
    const dto = new RenameRoomDto('room-7', 'Renamed Room');
    service.patchRenameRoom(token, dto).subscribe();

    const req = httpMock.expectOne(`${roomApi}room-7/`);
    expect(req.request.method).toBe('PATCH');
    expect(req.request.body).toEqual(dto);
    req.flush(dto);
  });

  it('disableRoomList should put ids payload', () => {
    const dto = new DisableRoomListDto(['a', 'b']);
    service.disableRoomList(token, dto).subscribe();

    const req = httpMock.expectOne(roomApi);
    expect(req.request.method).toBe('PUT');
    expect(req.request.body).toEqual(dto);
    req.flush([]);
  });
});

