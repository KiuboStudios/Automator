import { PagedResultDto } from "src/app/data/http/dto/paged-result-dto.model";
import { Paginator } from "../models/paginator.model";

@Injectable({
    providedIn: 'root',
})
export class PaginatorMapperService<T,Y> {
    pagedResultDtoToPaginator(
        pageSize: number,
        currentPage: number,
        pagedResultDto: PagedResultDto<T>
    ): Paginator<Y> {
        return new Paginator<Y>(
            pagedResultDto.count,
            pagedResultDto.total_pages,
            pageSize,
            currentPage
