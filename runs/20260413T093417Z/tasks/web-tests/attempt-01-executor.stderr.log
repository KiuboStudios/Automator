name: Package WEB

on:
  workflow_dispatch:
  push:
    branches: ['main']
    paths:
      - 'kiubo-web/**'
      - '.github/workflows/kiubo-web-package.yml'
      - '!kiubo-web/dist-staging/**'
      - '!kiubo-web/dist-production/**'

concurrency:
  group: package-web-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: write

jobs:
  build-and-package:
    if: github.event_name == 'workflow_dispatch' || github.actor != 'github-actions[bot]'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v5
        with:
          fetch-depth: 0

      - name: Build Angular app for staging
        run: |
          cd kiubo-web/
          docker build -f Dockerfile-build -t kiubo-build-staging --build-arg environment=staging .
          STAGING_CONTAINER=$(docker create kiubo-build-staging)
          docker cp "$STAGING_CONTAINER:/app/dist" ./dist-temp-staging
          docker rm "$STAGING_CONTAINER"
          docker rmi kiubo-build-staging

      - name: Build Angular app for production
        run: |
          cd kiubo-web/
          docker build -f Dockerfile-build -t kiubo-build-production --build-arg environment=production .
          PRODUCTION_CONTAINER=$(docker create kiubo-build-production)
          docker cp "$PRODUCTION_CONTAINER:/app/dist" ./dist-temp-production
          docker rm "$PRODUCTION_CONTAINER"
          docker rmi kiubo-build-production

      - name: Update dist directories
        run: |
          rm -rf ./kiubo-web/dist-staging/*
          cp -r ./kiubo-web/dist-temp-staging/* ./kiubo-web/dist-staging/
          rm -rf ./kiubo-web/dist-temp-staging

          rm -rf ./kiubo-web/dist-production/*
          cp -r ./kiubo-web/dist-temp-production/* ./kiubo-web/dist-production/
          rm -rf ./kiubo-web/dist-temp-production

      - name: Configure git identity
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

      - name: Commit and push if changes
        run: |
          git add ./kiubo-web/dist-staging/ ./kiubo-web/dist-production/
          if git diff --staged --quiet; then
            echo "No changes to commit"
          else
            git pull --rebase
            git commit -m "auto [$(date -u)]: package web for staging+production"
            git push
          fi
