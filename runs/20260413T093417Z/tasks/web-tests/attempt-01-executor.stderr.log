import { Injectable } from "@angular/core";
import { Router } from "@angular/router";
import { Observable, of } from "rxjs";
import { catchError, map } from "rxjs/operators";
import { DisableRoomListDto } from "src/app/data/http/dto/disable-room-list-dto.model";
import { DisableRoomDto } from "src/app/data/http/dto/room/disable-room-dto.model";
import { RenameRoomDto } from "src/app/data/http/dto/room/rename-room-dto.model";
import { RoomDto } from "src/app/data/http/dto/room/room-dto.model";
import { RoomHTTPService } from "src/app/data/http/room-http.service";
import { LocalStorageService } from "src/app/data/storage/local-storage.service";
import { SessionStorageService } from "src/app/data/storage/session-storage.service";
import { ErrorModel } from "../error/error.model";
import { PaginatorMapperService } from "../mappers/paginator-mapper.service";
import { RoomMapperService } from "../mappers/room-mapper.service";
import { Paginator } from "../models/paginator.model";
import { Player } from "../models/player.model";
import { Room } from "../models/room.model";
import { Result } from "../result.model";
import { BaseService } from "./base.service";


@Injectable({
  providedIn: 'root',
})
export class RoomService extends BaseService {
  
  constructor(
    private roomHttpService: RoomHTTPService,
    localStorageService: LocalStorageService,
    sessionStorageService: SessionStorageService,
    router: Router,
    private mapper: RoomMapperService,
    private paginatorMapper: PaginatorMapperService<RoomDto,Room>
  ) {
    super(localStorageService, sessionStorageService, router)
  }


  getRoomList(
    pageSize: number,
    nextPage: number
  ): Observable<Result<Paginator<Room>>> {
    const user = this.getUser();
    this.isLoadingSubject.next(true);
    var observable = this.roomHttpService.getRoomList(
      user.token, pageSize, nextPage
    ).pipe(
      map( roomDtoList => {
        var paginator = this.paginatorMapper.pagedResultDtoToPaginator(
          pageSize,
          nextPage,
          roomDtoList
        )
        var result = new Result<Paginator<Room>>();
        // if (roomDtoList.results.length == 0) {
        //   // result.error = new ErrorModel.Builder().build(this.EMPTY_VIEW_CODE);
        // } else {
          paginator.data = roomDtoList.results.map((room:RoomDto) => {
            return this.mapper.roomDtoToRoom(room)
          })
          result.result = paginator
        // }
        this.isLoadingSubject.next(false);
        
        return result;
    }),
      catchError((err) => {
        var result = new Result<Paginator<Room>>();
        result.error = new ErrorModel.Builder().build(err.status);
        
        this.onError(result.error);
        this.isLoadingSubject.next(false);
        
        return of(result);
      })
    )

    return observable
  }
  
  getRoomHistoricalList(
    pageSize: number, nextPage: number
  ): Observable<Result<Paginator<Room>>> {
    const user = this.getUser();
    this.isLoadingSubject.next(true);
    var observable = this.roomHttpService.getRoomHistoricalList(
      user.token, pageSize, nextPage
    ).pipe(
      map( roomDtoList => {
        var paginator = this.paginatorMapper.pagedResultDtoToPaginator(
          pageSize,
          nextPage,
          roomDtoList
        )
        var result = new Result<Paginator<Room>>();
        // if (roomDtoList.results.length == 0) {
        //   // result.error = new ErrorModel.Builder().build(this.EMPTY_VIEW_CODE);
        // } else {
          paginator.data = roomDtoList.results.map((room:RoomDto) => {
            return this.mapper.roomDtoToRoom(room)
          })
          result.result = paginator
        // }
        this.isLoadingSubject.next(false);
        
        return result;
    }),
      catchError((err) => {
        var result = new Result<Paginator<Room>>();
        result.error = new ErrorModel.Builder().build(err.status);
        
        this.onError(result.error);
        this.isLoadingSubject.next(false);
        
        return of(result);
      })
    )

    return observable
  }

  downloadPdf(roomId: string): Observable<Result<BlobPart>> {
    const user = this.getUser();
    this.isLoadingSubject.next(true);

    var observable = this.roomHttpService
      .downloadPdf(user.token, roomId).pipe(
        map( (blobPart: BlobPart) => {
        var result = new Result<BlobPart>()
        if (blobPart) {
          result.result = blobPart;
        } else {
          result.error = new ErrorModel.Builder().build(0);
        }

        this.isLoadingSubject.next(false);

        return result;
      }),
      catchError((err) => {
        var errorBuilder = new ErrorModel.Builder();
        errorBuilder.emptyViewErrorKey = "DASHBOARD.ERROR_PDF";
        errorBuilder.unknownErrorKey = "DASHBOARD.ERROR_PDF";

        var result = new Result<BlobPart>();
        result.error = errorBuilder.build(err.status);

        this.onError(result.error);
        this.isLoadingSubject.next(false);
        
        return of(result);
      }));

    return observable;
  }

  downloadNewPdf(roomId: string): Observable<Result<BlobPart>> {
    const user = this.getUser();
    this.isLoadingSubject.next(true);

    var observable = this.roomHttpService
      .downloadScoreSheetPdf(user.token, roomId).pipe(
        map((blobPart: BlobPart) => {
          var result = new Result<BlobPart>()
          if (blobPart) {
            result.result = blobPart;
          } else {
            result.error = new ErrorModel.Builder().build(0);
          }

          this.isLoadingSubject.next(false);

          return result;
        }),
        catchError((err) => {
          var errorBuilder = new ErrorModel.Builder();
          errorBuilder.emptyViewErrorKey = "DASHBOARD.ERROR_PDF";
          errorBuilder.unknownErrorKey = "DASHBOARD.ERROR_PDF";

          var result = new Result<BlobPart>();
          result.error = errorBuilder.build(err.status);

          this.onError(result.error);
          this.isLoadingSubject.next(false);

          return of(result);
        }));

    return observable;
  }

  disableRoomList(roomList: Room[]): Observable<Result<RoomDto[]>> {
    const user = this.getUser()
    var ids: string[] = []
