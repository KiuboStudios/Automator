    name: Deploy to Digital Ocean
    runs-on: ubuntu-latest
    needs: ['build-and-push', 'validate-terraform', 'api-test-and-lint', 'pdf-api-test']
    if: ${{ always() && !cancelled() && (needs.build-and-push.result == 'success' || needs.build-and-push.result == 'skipped') && (needs.validate-terraform.result == 'success' || needs.validate-terraform.result == 'skipped') && (needs.api-test-and-lint.result == 'success' || needs.api-test-and-lint.result == 'skipped') && (needs.pdf-api-test.result == 'success' || needs.pdf-api-test.result == 'skipped') }}
    steps:
      - name: Checkout
        uses: actions/checkout@v5
      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v4
        with:
          terraform_version: 1.10.5
      - name: Terraform Init
        run: |
          cd deploy-single/
          terraform init -backend-config=development.config.tfbackend
      - name: Resolve image tags and write tfvars
        env:
          UPDATE_API: ${{ inputs.deploy_api }}
          UPDATE_PDF: ${{ inputs.deploy_pdf_api }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          cd deploy-single/

          CURRENT_API_TAG="$(terraform state show digitalocean_app.kiubo-api 2>/dev/null | awk -F'= ' '/tag[[:space:]]*=/{gsub(/"/, "", $2); gsub(/ /, "", $2); print $2; exit}')"
          CURRENT_PDF_TAG="$(terraform state show digitalocean_app.kiubo-pdf-api 2>/dev/null | awk -F'= ' '/tag[[:space:]]*=/{gsub(/"/, "", $2); gsub(/ /, "", $2); print $2; exit}')"

          if [ -z "$CURRENT_API_TAG" ]; then CURRENT_API_TAG="development"; fi
          if [ -z "$CURRENT_PDF_TAG" ]; then CURRENT_PDF_TAG="development"; fi

          TARGET_API_TAG="$CURRENT_API_TAG"
          TARGET_PDF_TAG="$CURRENT_PDF_TAG"

          if [ "$UPDATE_API" = "true" ]; then TARGET_API_TAG="$IMAGE_TAG"; fi
          if [ "$UPDATE_PDF" = "true" ]; then TARGET_PDF_TAG="$IMAGE_TAG"; fi

          cat <<EOF > ci.auto.tfvars
          api_image_tag = "$TARGET_API_TAG"
          pdf_api_image_tag = "$TARGET_PDF_TAG"
          EOF
      - name: Show image tags
        run: |
          cd deploy-single/
          echo "Deploying with:"
          cat ci.auto.tfvars
      - name: Terraform Plan
        run: |
          cd deploy-single/
          terraform plan
      - name: Terraform Apply
        run: |
          cd deploy-single/
          terraform apply -auto-approve

