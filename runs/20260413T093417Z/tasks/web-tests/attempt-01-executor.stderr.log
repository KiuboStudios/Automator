import { Injectable } from "@angular/core";
import { RoomDetailDto } from "src/app/data/http/dto/room/room-detail-dto.model";
import { RoomDto } from "src/app/data/http/dto/room/room-dto.model";
import { Player } from "../models/player.model";
import { Room } from "../models/room.model";
import { DisableRoomDto } from "src/app/data/http/dto/room/disable-room-dto.model";
import { RenameRoomDto } from "src/app/data/http/dto/room/rename-room-dto.model";

@Injectable({
  providedIn: 'root',
})
export class RoomMapperService {

  roomDtoToRoom(roomDto: RoomDto): Room {
    var name
    if (roomDto.name == null || roomDto.name == "") {
      name = roomDto.host_name
    } else {
      name = roomDto.name
    }
    return new Room(
      roomDto.id,
      new Date(roomDto.created_at * 1000),
      roomDto.num_games,
      roomDto.num_players,
      name,
      roomDto.enabled
    )
  }

  roomToRenameRoomDto(room: Room): RenameRoomDto {
    return new RenameRoomDto(room.id, room.name)
  }

  roomToDisableRoomDto(room: Room, enabled: boolean = false): DisableRoomDto {
    return new DisableRoomDto(room.id, enabled)
  }

  roomDetailToPlayerList(roomDetail: RoomDetailDto): Player[] {
    let playerMap = new Map<string, Player>()
    roomDetail.games.forEach( game => {
      game.scores.forEach(score => {
        let player = playerMap.get(score.player_name)
        if (!player) {
          player = new Player(
            score.player_name,
            score.score,
            score.booth
          )
          playerMap.set(score.player_name, player)
        } else {
          player.score = player.score + score.score
        }
      })
    })
    var list = Array.from( playerMap.values() )
    list.sort((a,b) => b.score-a.score)
    
    var pos = 1;
    list.forEach(player => {
      player.pos = pos++;
    })

    return list;
  }
}

