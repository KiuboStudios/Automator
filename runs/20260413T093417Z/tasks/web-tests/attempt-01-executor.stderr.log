name: Deploy API to Staging

env:
  DOCTL_VERSION: 1.154.0

on:
  workflow_dispatch:
  push:
    branches: ['main']
    paths:
      - 'kiubo-api/**'
      - 'kiubo-pdf-api/**'
      - 'deploy-single/**'
      - '.github/workflows/kiubo-api-staging-deploy.yml'

concurrency:
  group: deploy-api-staging-${{ github.ref }}
  cancel-in-progress: true

jobs:
  changes:
    name: Detect Changed Areas
    runs-on: ubuntu-latest
    outputs:
      api_changed: ${{ steps.filter.outputs.api_changed }}
      pdf_changed: ${{ steps.filter.outputs.pdf_changed }}
      infra_changed: ${{ steps.filter.outputs.infra_changed }}
    steps:
      - name: Checkout
        uses: actions/checkout@v5
        with:
          fetch-depth: 0
      - name: Detect changes
        id: filter
        if: github.event_name != 'workflow_dispatch'
        uses: dorny/paths-filter@v3
        with:
          filters: |
            api_changed:
              - 'kiubo-api/**'
            pdf_changed:
              - 'kiubo-pdf-api/**'
            infra_changed:
              - 'deploy-single/**'

  api-test-and-lint:
    name: Test and Lint API
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.api_changed == 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v5
      - name: Test
        run: |
          cd kiubo-api/
          docker compose run --rm api sh -c "python manage.py wait_for_db && python manage.py test && flake8"

  pdf-api-test:
    name: Test PDF API
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'workflow_dispatch' || needs.changes.outputs.pdf_changed == 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v5
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: kiubo-pdf-api/package-lock.json
      - name: Install dependencies
        run: |
          cd kiubo-pdf-api/
          npm ci
      - name: Run tests
        run: |
          cd kiubo-pdf-api/
          npm test

  build-and-push:
    name: Build and Push Changed Images
    runs-on: ubuntu-latest
    needs: [changes, api-test-and-lint, pdf-api-test]
    if: ${{ always() && !cancelled() && (github.event_name == 'workflow_dispatch' || needs.changes.outputs.api_changed == 'true' || needs.changes.outputs.pdf_changed == 'true') && (needs.api-test-and-lint.result == 'success' || needs.api-test-and-lint.result == 'skipped') && (needs.pdf-api-test.result == 'success' || needs.pdf-api-test.result == 'skipped') }}
    steps:
      - name: Checkout
        uses: actions/checkout@v5
      - name: Install DigitalOcean CLI
        run: |
          curl -fsSL "https://github.com/digitalocean/doctl/releases/download/v${DOCTL_VERSION}/doctl-${DOCTL_VERSION}-linux-amd64.tar.gz" -o doctl.tar.gz
          tar -xf doctl.tar.gz
          sudo mv doctl /usr/local/bin/doctl
          doctl version
      - name: Authenticate Docker with DigitalOcean Container Registry
        env:
          DIGITALOCEAN_ACCESS_TOKEN: ${{ secrets.DIGITALOCEAN_TOKEN }}
        run: doctl --access-token "$DIGITALOCEAN_ACCESS_TOKEN" registry login
      - name: Build, tag, and push selected images
        env:
          DOCKER_REGISTRY: ${{ secrets.DO_CONTAINER_REGISTRY }}
          IMAGE_TAG: ${{ github.sha }}
          BUILD_API: ${{ github.event_name == 'workflow_dispatch' || needs.changes.outputs.api_changed == 'true' }}
          BUILD_PDF: ${{ github.event_name == 'workflow_dispatch' || needs.changes.outputs.pdf_changed == 'true' }}
        run: |
          PDF_DOCKER_REGISTRY="${DOCKER_REGISTRY%/kiubo-api}/kiubo-pdf-api"

          if [ "$BUILD_API" = "true" ]; then
            echo "Building API image"
            cd kiubo-api/
            docker build -t "$DOCKER_REGISTRY:$IMAGE_TAG" --target=staging .
            docker push "$DOCKER_REGISTRY:$IMAGE_TAG"
            cd ..
          fi

          if [ "$BUILD_PDF" = "true" ]; then
            echo "Building PDF API image"
            cd kiubo-pdf-api/
            docker build -t "$PDF_DOCKER_REGISTRY:$IMAGE_TAG" .
            docker push "$PDF_DOCKER_REGISTRY:$IMAGE_TAG"
            cd ..
          fi

  deploy-staging:
    name: Deploy to Digital Ocean
    runs-on: ubuntu-latest
    needs: [changes, build-and-push]
    if: ${{ always() && !cancelled() && (github.event_name == 'workflow_dispatch' || needs.changes.outputs.api_changed == 'true' || needs.changes.outputs.pdf_changed == 'true' || needs.changes.outputs.infra_changed == 'true') && (needs.build-and-push.result == 'success' || needs.build-and-push.result == 'skipped') }}
    steps:
      - name: Checkout
        uses: actions/checkout@v5
      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v4
        with:
          terraform_version: 1.10.5
      - name: Terraform Init
        run: |
          cd deploy-single/
          terraform init -backend-config=staging.config.tfbackend
      - name: Resolve image tags and write tfvars
        env:
          UPDATE_API: ${{ github.event_name == 'workflow_dispatch' || needs.changes.outputs.api_changed == 'true' }}
          UPDATE_PDF: ${{ github.event_name == 'workflow_dispatch' || needs.changes.outputs.pdf_changed == 'true' }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          cd deploy-single/

          CURRENT_API_TAG="$(terraform state show digitalocean_app.kiubo-api 2>/dev/null | awk -F'= ' '/tag[[:space:]]*=/{gsub(/"/, "", $2); gsub(/ /, "", $2); print $2; exit}')"
          CURRENT_PDF_TAG="$(terraform state show digitalocean_app.kiubo-pdf-api 2>/dev/null | awk -F'= ' '/tag[[:space:]]*=/{gsub(/"/, "", $2); gsub(/ /, "", $2); print $2; exit}')"

          if [ -z "$CURRENT_API_TAG" ]; then CURRENT_API_TAG="staging"; fi
          if [ -z "$CURRENT_PDF_TAG" ]; then CURRENT_PDF_TAG="staging"; fi

          TARGET_API_TAG="$CURRENT_API_TAG"
          TARGET_PDF_TAG="$CURRENT_PDF_TAG"

          if [ "$UPDATE_API" = "true" ]; then TARGET_API_TAG="$IMAGE_TAG"; fi
          if [ "$UPDATE_PDF" = "true" ]; then TARGET_PDF_TAG="$IMAGE_TAG"; fi

          cat <<EOF > ci.auto.tfvars
          api_image_tag = "$TARGET_API_TAG"
          pdf_api_image_tag = "$TARGET_PDF_TAG"
          EOF

          echo "Deploying api_image_tag=$TARGET_API_TAG"
          echo "Deploying pdf_api_image_tag=$TARGET_PDF_TAG"
          cat ci.auto.tfvars
      - name: Terraform Plan
        run: |
          cd deploy-single/
          terraform plan
      - name: Terraform Apply
        run: |
          cd deploy-single/
          terraform apply -auto-approve

