import { HttpClient, HttpParams } from "@angular/common/http";
import { Injectable } from "@angular/core";
import { Observable } from "rxjs";
import { TranslationService } from "src/app/ui/i18n";
import { environment } from "src/environments/environment";
import { BaseHttpService } from "./base-http.service";
import { DisableRoomListDto } from "./dto/disable-room-list-dto.model";
import { PagedResultDto } from "./dto/paged-result-dto.model";
import { DisableRoomDto } from "./dto/room/disable-room-dto.model";
import { RenameRoomDto } from "./dto/room/rename-room-dto.model";
import { RoomDetailDto } from "./dto/room/room-detail-dto.model";
import { RoomDto } from "./dto/room/room-dto.model";
import { TicketInfoDto } from "./dto/room/ticket-info-dto.model";


const GAME_URL = `${environment.apiUrl}game/`
const TICKET_URL = GAME_URL + 'ticket/'
const API_ROOM_URL = GAME_URL + `room/`;
const TICKET_INFO = GAME_URL + 'ticket-json/'
const PDF_API_SCORE_SHEET_URL = `${environment.pdfApiUrl}score-sheet`

@Injectable({
  providedIn: 'root',
})
export class RoomHTTPService extends BaseHttpService {
  constructor(
    private http: HttpClient,
    private translationService: TranslationService) {
    super()
  }
  
  getRoomList(
    token: string,
    pageSize: number,
    nextPage: number
  ): Observable<PagedResultDto<RoomDto>> {
    const params = new HttpParams()
      .set('page_size', pageSize)
      .set('page', nextPage)
    return this.http.get<PagedResultDto<RoomDto>>(API_ROOM_URL, {
      params: params,
      headers: this.getHeaders(token)
    })
  }

  getRoomDetail(token: string, roomId: String): Observable<RoomDetailDto> {
    return this.http.get<RoomDetailDto>(API_ROOM_URL + roomId + "/", {
      headers: this.getHeaders(token)
    })
  }

  getRoomHistoricalList(
    token: string,
    pageSize: number,
    nextPage: number
  ): Observable<PagedResultDto<RoomDto>> {
    const params = new HttpParams()
    .set('enabled', 0)
    .set('page_size', pageSize)
    .set('page', nextPage)
    return this.http.get<PagedResultDto<RoomDto>>(API_ROOM_URL, {
      headers: this.getHeaders(token),
      params: params
    })
  }

  downloadPdf(token: string, roomId: string): Observable<BlobPart> {    
    return this.http.get(TICKET_URL + roomId, {
      headers: this.getHeadersLanguage(token, this.translationService.getSelectedLanguage()),
      params: {
        time_zone: Intl.DateTimeFormat().resolvedOptions().timeZone
      },
      responseType: 'blob' 
    });
  }

  downloadScoreSheetPdf(token: string, roomId: string): Observable<BlobPart> {
    return this.http.get(PDF_API_SCORE_SHEET_URL, {
      headers: this.getHeaders(token),
      params: {
        room_id: roomId
      },
      responseType: 'blob'
    });
  }

  getTicketInfo(token: string, roomId: string): Observable<TicketInfoDto> {
    return this.http.get<TicketInfoDto>(TICKET_INFO + roomId, {
      headers: this.getHeaders(token),
    });
  }
  
  patchRoom(token: string, roomDto: RoomDto): Observable<RoomDto> {
    return this.http.patch<RoomDto>(API_ROOM_URL + roomDto.id + '/', roomDto, {
      headers: this.getHeaders(token)
    });
  }

  patchDisableRoom(token: string, disableRoomDto: DisableRoomDto): Observable<DisableRoomDto> {
    return this.http.patch<RoomDto>(API_ROOM_URL + disableRoomDto.id + '/', disableRoomDto, {
      headers: this.getHeaders(token)
    });
  }

  patchRenameRoom(token: string, renameRoomDto: RenameRoomDto): Observable<RenameRoomDto> {
    return this.http.patch<RoomDto>(API_ROOM_URL + renameRoomDto.id + '/', renameRoomDto, {
      headers: this.getHeaders(token)
    });
  }

  disableRoomList(
    token: string,
    model: DisableRoomListDto): Observable<RoomDto[]> {
    return this.http.put<RoomDto[]>(API_ROOM_URL, model, {
      headers: this.getHeaders(token)
    });
  }
}

