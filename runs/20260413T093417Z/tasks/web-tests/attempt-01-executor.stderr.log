import { BehaviorSubject, Observable } from "rxjs";
import { EmptyViewErrorModel, ErrorModel, UnauthorizedErrorModel } from "../domain/error/error.model";
import { Notification } from 'src/app/domain/models/notification.model';
import { BaseService } from "../domain/services/base.service";

export class BaseComponent {

  private baseService?: BaseService;

  private _hasErrorSubject: BehaviorSubject<boolean> =
            new BehaviorSubject<boolean>(false);
  public hasError$: Observable<boolean> =
            this._hasErrorSubject.asObservable();
  
  private _errorModelSubject: BehaviorSubject<ErrorModel> =
            new BehaviorSubject<ErrorModel>(ErrorModel.UNKNOWN_ERROR);
  public errorModel$: Observable<ErrorModel> =
            this._errorModelSubject.asObservable();
  
  public errorModel: ErrorModel = ErrorModel.UNKNOWN_ERROR;

  constructor(baseService?: BaseService) {
    this.baseService = baseService;
  }

  protected onError(error: ErrorModel) {
    this.errorModel = error;
    this._hasErrorSubject.next(true);
    
    switch (error.constructor) {
      case UnauthorizedErrorModel:
        this.onUnauthorized(error);
        break;
      case EmptyViewErrorModel:
        this.onEmptyViewError(error as EmptyViewErrorModel);
        break;
      default:
        this.onGenericError(error);
        break;
    }
  }

  onEmptyViewError(error: EmptyViewErrorModel) {
    this.onGenericError(error);
  }

  /**
   * Template for generic error
   */
   onGenericError(errorModel: ErrorModel) {

  }

  sendNotificationError(errorModel: ErrorModel) {
    var notification = new Notification(
      errorModel.titleKey,
      errorModel.descriptionKey,
      errorModel.level,
      true,
      true
    )
    if (this.baseService) {
      this.baseService.sendNotification(notification);
    }
  }

  private onUnauthorized(error: UnauthorizedErrorModel) {
    document.location.reload();
  }
}
