import { Router } from '@angular/router';
import { of, throwError } from 'rxjs';
import { UserHTTPService } from 'src/app/data/http/user-http.service';
import { LocalStorageService } from 'src/app/data/storage/local-storage.service';
import { SessionStorageService } from 'src/app/data/storage/session-storage.service';
import { UserMapperService } from '../mappers/user-mapper.service';
import { UserService } from './user.service';

describe('UserService', () => {
  let service: UserService;
  let userHttpService: jasmine.SpyObj<UserHTTPService>;
  let localStorageService: jasmine.SpyObj<LocalStorageService>;
  let sessionStorageService: jasmine.SpyObj<SessionStorageService>;
  let userMapperService: jasmine.SpyObj<UserMapperService>;
  let router: jasmine.SpyObj<Router>;

  beforeEach(() => {
    userHttpService = jasmine.createSpyObj('UserHTTPService', ['getStationList']);
    localStorageService = jasmine.createSpyObj('LocalStorageService', ['removeToken']);
    sessionStorageService = jasmine.createSpyObj('SessionStorageService', ['getUser', 'removeUser']);
    userMapperService = jasmine.createSpyObj('UserMapperService', ['stationDtoToStation']);
    router = jasmine.createSpyObj('Router', ['navigate']);

    sessionStorageService.getUser.and.returnValue({ token: 'token-1' } as any);

    service = new UserService(
      userHttpService,
      localStorageService,
      sessionStorageService,
      userMapperService,
      router
    );
  });

  it('getStations should map station DTOs to domain stations', () => {
    userHttpService.getStationList.and.returnValue(of([{ id: 's1', name: 'Station 1' }] as any));
    userMapperService.stationDtoToStation.and.returnValue({ id: 's1', name: 'Station 1' } as any);

    service.getStations().subscribe((result) => {
      expect(result.isSuccessful()).toBeTrue();
      expect(result.result.length).toBe(1);
      expect(result.result[0].name).toBe('Station 1');
      expect(userMapperService.stationDtoToStation).toHaveBeenCalledTimes(1);
    });
  });

  it('getStations should return empty-view error when no stations exist', () => {
    userHttpService.getStationList.and.returnValue(of([]));

    service.getStations().subscribe((result) => {
      expect(result.isSuccessful()).toBeFalse();
      expect(result.error.titleKey).toBe('ERROR.DEFAULT_EMPTY');
    });
  });

  it('getStations should handle unauthorized errors and trigger logout flow', () => {
    userHttpService.getStationList.and.returnValue(throwError(() => ({ status: 401 })));

    service.getStations().subscribe((result) => {
      expect(result.isSuccessful()).toBeFalse();
      expect(localStorageService.removeToken).toHaveBeenCalled();
      expect(sessionStorageService.removeUser).toHaveBeenCalled();
      expect(router.navigate).toHaveBeenCalledWith(['/auth/login'], { queryParams: {} });
    });
  });
});
