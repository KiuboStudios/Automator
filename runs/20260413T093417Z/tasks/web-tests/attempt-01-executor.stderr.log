import { Injectable } from '@angular/core';
import { Observable, of } from 'rxjs';
import { HttpClient } from '@angular/common/http';
import { catchError, map } from 'rxjs/operators';
import { environment } from 'src/environments/environment';
import { BaseHttpService } from './base-http.service';
import { TokenDto } from './dto/user/token-dto.model';
import { UserDto } from './dto/user/user-dto.model';
import { BoothDto } from './dto/user/booth-dto.model';
import { StationDto } from './dto/user/station-dto.model';
import { ResetPasswordDto } from './dto/reset-password-dto.model';
import { VerifyEmailDto } from './dto/user/verify-email-dto.model';
import { CenterDto } from './dto/user/center-dto.model';

const API_USERS_URL = `${environment.apiUrl}user/`;
const API_STATIONS_URL = `${API_USERS_URL}booth/`;
const API_CREATE_URL = `${API_USERS_URL}create/`;
const API_UPLOAD_IMAGE = `${API_USERS_URL}center/upload-image/`;

@Injectable({
  providedIn: 'root',
})
export class UserHTTPService extends BaseHttpService {
  constructor(private http: HttpClient) {
    super();
  }

  login(email: string, password: string): Observable<TokenDto> {
    return this.http.post<TokenDto>(`${API_USERS_URL}token/`, {
      email,
      password,
    });
  }

  createBooth(authToken: string, temp_token: string, name: string): Observable<BoothDto> {
    return this.http.post<BoothDto>(`${API_USERS_URL}booth/`, {
      temp_token,
      name,
    }, {
      headers: this.getHeaders(authToken),
    });
  }

  getUser(token: string): Observable<UserDto> {
    return this.http.get<UserDto>(`${API_USERS_URL}me/`, {
      headers: this.getHeaders(token),
    });
  }

  createUser(user: UserDto): Observable<UserDto> {
    return this.http.post<UserDto>(API_CREATE_URL, user);
  }

  forgotPassword(email: string): Observable<boolean> {
    return this.http.post<boolean>(`${API_USERS_URL}forgot-password/`, {
      email,
    });
  }

  resetPassword(resetPasswordDto: ResetPasswordDto): Observable<ResetPasswordDto> {
    return this.http.post<ResetPasswordDto>(
      `${API_USERS_URL}reset-password/`,
      resetPasswordDto
    );
  }

  verifyEmail(verifyEmail: VerifyEmailDto): Observable<VerifyEmailDto> {
    return this.http.post<VerifyEmailDto>(
      `${API_USERS_URL}verify-email/`,
      verifyEmail
    );
  }

  getStationList(token: string): Observable<StationDto[]> {
    return this.http.get<StationDto[]>(API_STATIONS_URL, {
      headers: this.getHeaders(token),
    });
  }

  uploadImage(file: File, token: string): Observable<any> {
    const formData = new FormData();
    formData.append('image', file, file.name);
    console.log("FORMDATA", formData);
    return this.http.patch<any>(API_UPLOAD_IMAGE, formData, {
      headers: this.getHeadersWithMultiPart(token),
    });
  }
  
  

  patchCenter(token: string, center: object): Observable<CenterDto> {
    return this.http.patch<CenterDto>(`${API_USERS_URL}center/`,  center , {
      headers: this.getHeaders(token),
    });
  }

  patchUserProfile(token: string, user: object): Observable<UserDto> {
    return this.http.patch<UserDto>(`${API_USERS_URL}me/`, user, {
      headers: this.getHeaders(token),
    });
  }

  verifyToken(token: string, boothToken: string): Observable<boolean> {
    return this.http.get<boolean>(`${API_USERS_URL}verify-temp-booth-token/?token=${boothToken}`, {
      headers: this.getHeaders(token),
      observe: 'response',
    }).pipe(
      map(response => response.status === 200),
      catchError(() => of(false))
    );
  }

  deleteStation(token: string, stationId: string): Observable<void> {
    return this.http.delete<void>(`${API_STATIONS_URL}${stationId}/`, {
      headers: this.getHeaders(token),
    });
  }

  patchRenameStation(token: string, stationId: string, name: string): Observable<StationDto> {
    return this.http.patch<StationDto>(`${API_STATIONS_URL}${stationId}/`, { name }, {
      headers: this.getHeaders(token),
    });
  }
}

