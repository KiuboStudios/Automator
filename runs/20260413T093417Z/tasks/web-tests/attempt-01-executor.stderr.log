import { HttpClientTestingModule, HttpTestingController } from '@angular/common/http/testing';
import { TestBed } from '@angular/core/testing';
import { environment } from 'src/environments/environment';
import { CenterDto } from './dto/user/center-dto.model';
import { UserDto } from './dto/user/user-dto.model';
import { UserHTTPService } from './user-http.service';

describe('UserHTTPService', () => {
  let service: UserHTTPService;
  let httpMock: HttpTestingController;

  const token = 'auth-token';
  const usersApi = `${environment.apiUrl}user/`;
  const boothApi = `${usersApi}booth/`;

  beforeEach(() => {
    TestBed.configureTestingModule({
      imports: [HttpClientTestingModule],
      providers: [UserHTTPService],
    });

    service = TestBed.inject(UserHTTPService);
    httpMock = TestBed.inject(HttpTestingController);
  });

  afterEach(() => {
    httpMock.verify();
  });

  it('login should post credentials', () => {
    service.login('a@kiubo.com', 'pwd').subscribe();

    const req = httpMock.expectOne(`${usersApi}token/`);
    expect(req.request.method).toBe('POST');
    expect(req.request.body).toEqual({ email: 'a@kiubo.com', password: 'pwd' });
    req.flush({ token: 'ok' });
  });

  it('createBooth should post booth data with auth header', () => {
    service.createBooth(token, 'temp-1', 'Main Booth').subscribe();

    const req = httpMock.expectOne(boothApi);
    expect(req.request.method).toBe('POST');
    expect(req.request.body).toEqual({ temp_token: 'temp-1', name: 'Main Booth' });
    expect(req.request.headers.get('Authorization')).toBe(`Token ${token}`);
    req.flush({});
  });

  it('getUser should call me endpoint', () => {
    service.getUser(token).subscribe();

    const req = httpMock.expectOne(`${usersApi}me/`);
    expect(req.request.method).toBe('GET');
    req.flush({});
  });

  it('createUser should post full user payload', () => {
    const center: CenterDto = {
      id: 1,
      name: 'Center',
      address_1: 'a1',
      address_2: 'a2',
      postal_code: '12345',
      country_iso: 'US',
      web: 'https://example.com',
      facebook: 'https://facebook.com/example',
      vat: 'VAT',
      slogan: 'Go',
      image: 'img',
    };

    const user: UserDto = {
      email: 'user@kiubo.com',
      name: 'User',
      last_name: 'Last',
      is_marketing_allowed: true,
      center,
      password: 'pwd',
    };

    service.createUser(user).subscribe();

    const req = httpMock.expectOne(`${usersApi}create/`);
    expect(req.request.method).toBe('POST');
    expect(req.request.body).toEqual(user);
    req.flush(user);
  });

  it('forgotPassword should post email', () => {
    service.forgotPassword('mail@kiubo.com').subscribe();

    const req = httpMock.expectOne(`${usersApi}forgot-password/`);
    expect(req.request.method).toBe('POST');
    expect(req.request.body).toEqual({ email: 'mail@kiubo.com' });
    req.flush(true);
  });

  it('resetPassword should post reset payload', () => {
    const payload = { token: 't', password: 'p' } as any;
    service.resetPassword(payload).subscribe();

    const req = httpMock.expectOne(`${usersApi}reset-password/`);
    expect(req.request.method).toBe('POST');
    expect(req.request.body).toEqual(payload);
    req.flush(payload);
  });

  it('verifyEmail should post verify payload', () => {
    const payload = { token: 'verify-token' } as any;
    service.verifyEmail(payload).subscribe();

    const req = httpMock.expectOne(`${usersApi}verify-email/`);
    expect(req.request.method).toBe('POST');
    expect(req.request.body).toEqual(payload);
    req.flush(payload);
  });

  it('getStationList should call booth endpoint', () => {
    service.getStationList(token).subscribe();

    const req = httpMock.expectOne(boothApi);
    expect(req.request.method).toBe('GET');
    req.flush([]);
  });

  it('uploadImage should patch multipart form data', () => {
    const file = new File(['binary'], 'logo.png', { type: 'image/png' });

    service.uploadImage(file, token).subscribe();

    const req = httpMock.expectOne(`${usersApi}center/upload-image/`);
    expect(req.request.method).toBe('PATCH');
    expect(req.request.body instanceof FormData).toBeTrue();
    expect(req.request.headers.has('Content-Type')).toBeFalse();

    const body = req.request.body as FormData;
    expect(body.get('image')).toEqual(file);
    req.flush({ image: 'ok' });
  });

  it('patchCenter should patch center data', () => {
    const center = { name: 'Edited' };
    service.patchCenter(token, center).subscribe();

    const req = httpMock.expectOne(`${usersApi}center/`);
    expect(req.request.method).toBe('PATCH');
    expect(req.request.body).toEqual(center);
    req.flush({});
  });

  it('patchUserProfile should patch user profile data', () => {
    const profile = { name: 'New Name' };
    service.patchUserProfile(token, profile).subscribe();

    const req = httpMock.expectOne(`${usersApi}me/`);
    expect(req.request.method).toBe('PATCH');
    expect(req.request.body).toEqual(profile);
    req.flush({});
  });

  it('verifyToken should return true on 200 response', () => {
    let result: boolean | undefined;

    service.verifyToken(token, 'booth-token').subscribe((isValid) => {
      result = isValid;
    });

    const req = httpMock.expectOne(`${usersApi}verify-temp-booth-token/?token=booth-token`);
    expect(req.request.method).toBe('GET');
    req.flush({}, { status: 200, statusText: 'OK' });

    expect(result).toBeTrue();
  });

  it('verifyToken should return false on non-200 errors', () => {
    let result: boolean | undefined;

    service.verifyToken(token, 'bad-token').subscribe((isValid) => {
      result = isValid;
    });

    const req = httpMock.expectOne(`${usersApi}verify-temp-booth-token/?token=bad-token`);
    req.flush({}, { status: 500, statusText: 'Server error' });

    expect(result).toBeFalse();
  });

  it('deleteStation should call booth delete endpoint', () => {
    service.deleteStation(token, 'station-1').subscribe();

    const req = httpMock.expectOne(`${boothApi}station-1/`);
    expect(req.request.method).toBe('DELETE');
    req.flush({});
  });

  it('patchRenameStation should patch station name', () => {
    service.patchRenameStation(token, 'station-2', 'Renamed').subscribe();

    const req = httpMock.expectOne(`${boothApi}station-2/`);
    expect(req.request.method).toBe('PATCH');
    expect(req.request.body).toEqual({ name: 'Renamed' });
    req.flush({ id: 'station-2', name: 'Renamed' });
  });
});

