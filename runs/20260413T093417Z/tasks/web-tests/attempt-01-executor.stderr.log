import { RoomDetailDto } from 'src/app/data/http/dto/room/room-detail-dto.model';
import { RoomDto } from 'src/app/data/http/dto/room/room-dto.model';
import { Room } from '../models/room.model';
import { RoomMapperService } from './room-mapper.service';

describe('RoomMapperService', () => {
  let service: RoomMapperService;

  beforeEach(() => {
    service = new RoomMapperService();
  });

  it('roomDtoToRoom should fallback to host name when room name is empty', () => {
    const dto = new RoomDto('room-1', 1713000000, 4, 6, 'Host Name', '', true);

    const room = service.roomDtoToRoom(dto);

    expect(room.name).toBe('Host Name');
    expect(room.enabled).toBeTrue();
    expect(room.created.getTime()).toBe(1713000000 * 1000);
  });

  it('roomToRenameRoomDto should map id and name', () => {
    const room = new Room('room-2', new Date(), 1, 2, 'New Name', true);

    const renameDto = service.roomToRenameRoomDto(room);

    expect(renameDto.id).toBe('room-2');
    expect(renameDto.name).toBe('New Name');
  });

  it('roomDetailToPlayerList should aggregate scores and sort by total desc', () => {
    const detail: RoomDetailDto = {
      id: 'detail-1',
      name: 'Room',
      created_at: '2026-01-01',
      games: [
        {
          scores: [
            { id: 's1', player_name: 'Alice', score: 15, booth: 'B1' },
            { id: 's2', player_name: 'Bob', score: 9, booth: 'B2' },
          ],
        },
        {
          scores: [
            { id: 's3', player_name: 'Bob', score: 10, booth: 'B2' },
            { id: 's4', player_name: 'Alice', score: 1, booth: 'B1' },
          ],
        },
      ],
    };

    const players = service.roomDetailToPlayerList(detail);

    expect(players.length).toBe(2);
    expect(players[0].playerName).toBe('Bob');
    expect(players[0].score).toBe(19);
    expect(players[0].pos).toBe(1);
    expect(players[1].playerName).toBe('Alice');
    expect(players[1].score).toBe(16);
    expect(players[1].pos).toBe(2);
  });
});
import { Router } from '@angular/router';
import { of, throwError } from 'rxjs';
import { UserHTTPService } from 'src/app/data/http/user-http.service';
import { LocalStorageService } from 'src/app/data/storage/local-storage.service';
import { SessionStorageService } from 'src/app/data/storage/session-storage.service';
import { UserMapperService } from '../mappers/user-mapper.service';
import { UserService } from './user.service';

describe('UserService', () => {
  let service: UserService;
  let userHttpService: jasmine.SpyObj<UserHTTPService>;
  let localStorageService: jasmine.SpyObj<LocalStorageService>;
  let sessionStorageService: jasmine.SpyObj<SessionStorageService>;
  let userMapperService: jasmine.SpyObj<UserMapperService>;
  let router: jasmine.SpyObj<Router>;

  beforeEach(() => {
    userHttpService = jasmine.createSpyObj('UserHTTPService', ['getStationList']);
    localStorageService = jasmine.createSpyObj('LocalStorageService', ['removeToken']);
    sessionStorageService = jasmine.createSpyObj('SessionStorageService', ['getUser', 'removeUser']);
    userMapperService = jasmine.createSpyObj('UserMapperService', ['stationDtoToStation']);
    router = jasmine.createSpyObj('Router', ['navigate']);

    sessionStorageService.getUser.and.returnValue({ token: 'token-1' } as any);

    service = new UserService(
      userHttpService,
      localStorageService,
      sessionStorageService,
      userMapperService,
      router
    );
  });

  it('getStations should map station DTOs to domain stations', () => {
    userHttpService.getStationList.and.returnValue(of([{ id: 's1', name: 'Station 1' }] as any));
    userMapperService.stationDtoToStation.and.returnValue({ id: 's1', name: 'Station 1' } as any);

    service.getStations().subscribe((result) => {
      expect(result.isSuccessful()).toBeTrue();
      expect(result.result.length).toBe(1);
      expect(result.result[0].name).toBe('Station 1');
      expect(userMapperService.stationDtoToStation).toHaveBeenCalledTimes(1);
    });
  });

  it('getStations should return empty-view error when no stations exist', () => {
    userHttpService.getStationList.and.returnValue(of([]));

    service.getStations().subscribe((result) => {
      expect(result.isSuccessful()).toBeFalse();
      expect(result.error.titleKey).toBe('ERROR.DEFAULT_EMPTY');
    });
  });

  it('getStations should handle unauthorized errors and trigger logout flow', () => {
    userHttpService.getStationList.and.returnValue(throwError(() => ({ status: 401 })));

    service.getStations().subscribe((result) => {
      expect(result.isSuccessful()).toBeFalse();
      expect(localStorageService.removeToken).toHaveBeenCalled();
      expect(sessionStorageService.removeUser).toHaveBeenCalled();
      expect(router.navigate).toHaveBeenCalledWith(['/auth/login'], { queryParams: {} });
    });
  });
});
import { ChangeDetectorRef } from '@angular/core';
import { of } from 'rxjs';
import { Room } from 'src/app/domain/models/room.model';
import { Result } from 'src/app/domain/result.model';
import { RoomService } from 'src/app/domain/services/room.service';
import { NgbModal } from '@ng-bootstrap/ng-bootstrap';
import { RoomListComponent } from './room-list.component';

describe('RoomListComponent', () => {
  let component: RoomListComponent;
  let roomService: jasmine.SpyObj<RoomService> & { isLoading$: any };
  let modalService: jasmine.SpyObj<NgbModal>;
  let changeDetector: jasmine.SpyObj<ChangeDetectorRef>;

  const createRoom = (id: string, enabled: boolean = true): Room =>
    new Room(id, new Date('2026-01-01'), 2, 4, `Room ${id}`, enabled);

  beforeEach(() => {
    roomService = jasmine.createSpyObj('RoomService', [
      'disableRoomList',
      'disableRoom',
      'updateRoom',
      'downloadPdf',
      'downloadNewPdf',
      'sendNotification',
    ]) as jasmine.SpyObj<RoomService> & { isLoading$: any };
    roomService.isLoading$ = of(false);

    modalService = jasmine.createSpyObj('NgbModal', ['open']);
    changeDetector = jasmine.createSpyObj('ChangeDetectorRef', ['detectChanges']);

    component = new RoomListComponent(roomService, modalService, changeDetector);
  });

  it('ngOnInit should emit empty state for empty room list', () => {
    const emitted: boolean[] = [];
    component.isEmpty.subscribe((value) => emitted.push(value));
    component.roomList = [];

    component.ngOnInit();

    expect(emitted).toContain(true);
  });

  it('toggleSelected should add and remove room from selectedRooms', () => {
    const room = createRoom('1');

    component.toggleSelected(room);
    expect(room.selected).toBeTrue();
    expect(component.selectedRooms.map((r) => r.id)).toEqual(['1']);

    component.toggleSelected(room);
    expect(room.selected).toBeFalse();
    expect(component.selectedRooms.length).toBe(0);
  });

  it('toggleSelectedAll should select and unselect all rooms', () => {
    component.roomList = [createRoom('1'), createRoom('2')];

    component.toggleSelectedAll();
    expect(component.selectedRooms.length).toBe(2);
    expect(component.roomList.every((room) => room.selected)).toBeTrue();

    component.toggleSelectedAll();
    expect(component.selectedRooms.length).toBe(0);
    expect(component.roomList.every((room) => !room.selected)).toBeTrue();
  });

  it('archiveRoom should hide room after successful disable', () => {
    jasmine.clock().install();
    const room = createRoom('10');
    const response = new Result<any>();
    response.result = { id: '10', enabled: false };
    roomService.disableRoom.and.returnValue(of(response));

    component.archiveRoom(room);
    jasmine.clock().tick(1001);

    expect(component.hiddenRoomIds.has('10')).toBeTrue();
    expect(component.archivingRooms.has('10')).toBeFalse();
    jasmine.clock().uninstall();
  });

  it('downloadPdf should open a blob on successful request and reset loading state', () => {
    const room = createRoom('20');
    component.roomList = [room];

    const response = new Result<BlobPart>();
    response.result = new Blob(['pdf']);
    roomService.downloadPdf.and.returnValue(of(response));

    const openPdfSpy = spyOn<any>(component, 'openPdfBlob');

    component.downloadPdf('20');

    expect(roomService.downloadPdf).toHaveBeenCalledWith('20');
    expect(openPdfSpy).toHaveBeenCalled();
    expect(room.isLoading).toBeFalse();
    expect(changeDetector.detectChanges).toHaveBeenCalled();
  });
});

