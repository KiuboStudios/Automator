import { Component, Input, OnInit,EventEmitter, Output, ChangeDetectorRef } from '@angular/core';
import { BehaviorSubject, Observable, Subscription } from 'rxjs';
import { RoomDto } from 'src/app/data/http/dto/room/room-dto.model';
import { Room } from 'src/app/domain/models/room.model';
import { Result } from 'src/app/domain/result.model';
import { Notification, NotificationLevel } from 'src/app/domain/models/notification.model';
import { RoomService } from 'src/app/domain/services/room.service';
import { BaseComponent } from '../../base.component';
import { ErrorModel } from 'src/app/domain/error/error.model';
import { NgbModal, ModalDismissReasons } from '@ng-bootstrap/ng-bootstrap';


@Component({
  selector: 'app-room-list',
  templateUrl: './room-list.component.html',
  styleUrls: ['./room-list.component.scss']
})

export class RoomListComponent extends BaseComponent implements OnInit {
  closeResult = '';
  selectedRoom: Room;
  private unsubscribe: Subscription[] = [];
  hiddenRoomIds: Set<string> = new Set();
  hasEnabledRooms: boolean = false;
  

  @Input() roomList: Room[] = [];
  @Output() isEmpty: EventEmitter<boolean> = new EventEmitter<boolean>();


  private _totalRoomsSubject: BehaviorSubject<number> = new BehaviorSubject<number>(0);
  public totalRooms$: Observable<number> = this._totalRoomsSubject.asObservable();
  isLoading$: Observable<boolean>;
  selectedRooms: Room[] = [];

  private selectedAll: boolean = false;

  archivingRooms: Set<string> = new Set();

  constructor(
    private roomService: RoomService,
    private modalService: NgbModal,
    private changeDetector: ChangeDetectorRef,
  ) {
    super(roomService);
    this.isLoading$ = this.roomService.isLoading$;
  }

  ngOnInit(): void {
    this._totalRoomsSubject.next(this.roomList.length);
    this.updateHasEnabledRooms();
    this.checkIfEmpty();
  }

  ngOnChanges(): void {
    this.checkIfEmpty();
  }

  private checkIfEmpty(): void {
    const isEmpty = this.roomList.length === 0;
    this.isEmpty.emit(isEmpty);
  }

  toggleSelected(room: Room) {
    if (room.selected) {
      this.selectedRooms = this.selectedRooms.filter((r: Room) => room.id != r.id);
    } else {
      this.selectedRooms.push(room);
    }
    room.selected = !room.selected;
  }

  toggleSelectedAll() {
    this.selectedAll = !this.selectedAll;
    this.roomList.forEach((room) => {
      room.selected = this.selectedAll;
    });
    if (this.selectedAll) {
      this.selectedRooms = this.roomList;
    } else {
      this.selectedRooms = [];
    }
  }

  archiveRoomList() {
    this.selectedRooms.forEach(room => this.archivingRooms.add(room.id));
    var subscription = this.roomService.disableRoomList(this.selectedRooms).subscribe(
      (res: Result<RoomDto[]>) => {
        if (res.isSuccessful() && res.result.length > 0) {
          this.sendNotificationSuccess("DASHBOARD.SUCCESS_DISABLE_ROOM_LIST");
          this.selectedRooms.forEach(room => this.hiddenRoomIds.add(room.id));
          this.selectedRooms = [];
          setTimeout(() => {
            this.selectedRooms.forEach(room => this.archivingRooms.delete(room.id));
            this.updateHasEnabledRooms();
          }, 1000);
  
        } else {
          this.selectedRooms.forEach(room => this.archivingRooms.delete(room.id));
          this.onError(res.error);
        }
      }
    );
    this.unsubscribe.push(subscription);
  }
  
  downloadPdf(roomId: string) {
    this.downloadRoomPdf(roomId, this.roomService.downloadPdf(roomId));
  }

  downloadNewPdf(roomId: string) {
    this.downloadRoomPdf(roomId, this.roomService.downloadNewPdf(roomId));
  }
  
  

  archiveRoom(room: Room, modalRef?: any) {
    this.archivingRooms.add(room.id);
    const subscription = this.roomService.disableRoom(room).subscribe(
      (result: Result<RoomDto>) => {
        if (result.isSuccessful() && !result.result.enabled) {
          this.sendNotificationSuccess("DASHBOARD.SUCCESS_DISABLE_ROOM");
          setTimeout(() => {
            this.hiddenRoomIds.add(room.id);
            this.archivingRooms.delete(room.id); 
            this.updateHasEnabledRooms();
            if (modalRef) {
              modalRef.dismiss('Room archived');
            }
          }, 1000); 
        } else {
          this.archivingRooms.delete(room.id); 
          this.onError(result.error);
        }
      }
    );
    this.unsubscribe.push(subscription);
  }
  
  

  onGenericError(errorModel: ErrorModel): void {
    this.sendNotificationError(errorModel);
  }

  updateRoomName(room: Room, newName: string) {
    room.name = newName;
    var subscription = this.roomService.updateRoom(room).subscribe((result: Result<string>) => {
        if (result.isSuccessful()) {
            this.sendNotificationSuccess("DASHBOARD.SUCCESS_NAME");
        } else {
            this.onError(result.error);
        }
    });
    this.unsubscribe.push(subscription);
}

  private sendNotificationSuccess(description: string) {
    var notification = new Notification(
      "",
      description,
      NotificationLevel.INFO,
      true,
      false
    );
    this.roomService.sendNotification(notification);
  }

  ngOnDestroy(): void {
    this.unsubscribe.forEach((sb) => sb.unsubscribe());
  }

  openRoomDetail(room: Room, content: any) {
    this.selectedRoom = room;
    const modalRef = this.modalService.open(content, {
      ariaLabelledBy: 'modal-basic-title',
      windowClass: 'modal-dialog-scrollable'
    });
    modalRef.result.then((result) => {
      this.closeResult = `Closed with: ${result}`;
    }, (reason) => {
      this.closeResult = `Dismissed ${this.getDismissReason(reason)}`;
    });
  }

  private getDismissReason(reason: any): string {
    if (reason === ModalDismissReasons.ESC) {
      return '';
    } else if (reason === ModalDismissReasons.BACKDROP_CLICK) {
      return '';
    } else {
      return '';
    }
  }

  private updateHasEnabledRooms() {
    this.hasEnabledRooms = this.roomList.some(room => room.enabled && !this.hiddenRoomIds.has(room.id));
  
    if (!this.hasEnabledRooms) {
      this.roomList = [];
      this._totalRoomsSubject.next(0); 
    }
  }

  private downloadRoomPdf(
    roomId: string,
    request$: Observable<Result<BlobPart>>
  ) {
    const room = this.roomList.find(r => r.id === roomId);
    this.setRoomLoading(room, true);

    const subscription = request$.subscribe(
      (res: Result<BlobPart>) => {
        if (res.isSuccessful()) {
          this.openPdfBlob(res.result);
        }

        this.setRoomLoading(room, false);

        if (!res.isSuccessful()) {
          this.onError(res.error);
        }
      },
      (error) => {
        this.setRoomLoading(room, false);
        this.onError(error);
      }
    );
    this.unsubscribe.push(subscription);
  }

  private openPdfBlob(blobPart: BlobPart) {
    var blob = new Blob([blobPart], { type: "application/pdf" });
    var url = window.URL.createObjectURL(blob);
    window.open(url, '_blank');
  }

  private setRoomLoading(room: Room | undefined, isLoading: boolean) {
    if (room) {
      room.isLoading = isLoading;
      this.changeDetector.detectChanges();
    }
  }
}

