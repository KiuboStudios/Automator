      'sendNotification',
    ]) as jasmine.SpyObj<RoomService> & { isLoading"'$: any };
    roomService.isLoading$ = of(false);

    modalService = jasmine.createSpyObj('"'NgbModal', ['open']);
    changeDetector = jasmine.createSpyObj('ChangeDetectorRef', ['detectChanges']);

    component = new RoomListComponent(roomService, modalService, changeDetector);
  });

  it('ngOnInit should emit empty state for empty room list', () => {
    const emitted: boolean[] = [];
    component.isEmpty.subscribe((value) => emitted.push(value));
    component.roomList = [];

    component.ngOnInit();

    expect(emitted).toContain(true);
  });

  it('toggleSelected should add and remove room from selectedRooms', () => {
    const room = createRoom('1');

    component.toggleSelected(room);
    expect(room.selected).toBeTrue();
    expect(component.selectedRooms.map((r) => r.id)).toEqual(['1']);

    component.toggleSelected(room);
    expect(room.selected).toBeFalse();
    expect(component.selectedRooms.length).toBe(0);
  });

  it('toggleSelectedAll should select and unselect all rooms', () => {
    component.roomList = [createRoom('1'), createRoom('2')];

    component.toggleSelectedAll();
    expect(component.selectedRooms.length).toBe(2);
    expect(component.roomList.every((room) => room.selected)).toBeTrue();

    component.toggleSelectedAll();
    expect(component.selectedRooms.length).toBe(0);
    expect(component.roomList.every((room) => "'!room.selected)).toBeTrue();
  });

  it('"'archiveRoom should hide room after successful disable', () => {
    jasmine.clock().install();
